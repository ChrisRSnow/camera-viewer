<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/feed_background">

    <ImageView
        android:id="@+id/imageFeed"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/camera_feed_description"
        android:scaleType="fitCenter"
        android:background="@color/feed_background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/controlsBar" />

    <TextView
        android:id="@+id/textStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@color/status_pill_background"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:textColor="@color/status_pill_text"
        android:textSize="14sp"
        android:text="@string/status_idle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textListeningStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@color/status_pill_background"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:textColor="@color/status_pill_text"
        android:textSize="14sp"
        android:text="@string/listening_status_off"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/imgLastSnapshot"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_margin="16dp"
        android:background="@color/controls_background"
        android:contentDescription="@string/last_snapshot_description"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/controlsBar"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/controlsBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@color/controls_background"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btnStartStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:textSize="10.5sp"
            android:minHeight="0dp"
            android:paddingVertical="2dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/start_monitoring" />

        <Button
            android:id="@+id/btnManualSnapshot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:textSize="10.5sp"
            android:minHeight="0dp"
            android:paddingVertical="2dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/manual_snapshot" />

        <Button
            android:id="@+id/btnViewSnapshots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:textSize="10.5sp"
            android:minHeight="0dp"
            android:paddingVertical="2dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/view_snapshots" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="10.5sp"
            android:minHeight="0dp"
            android:paddingVertical="2dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/settings_title" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
